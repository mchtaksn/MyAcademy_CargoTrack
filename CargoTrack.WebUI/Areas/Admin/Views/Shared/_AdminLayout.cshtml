@using Microsoft.AspNetCore.Identity
@using CargoTrack.Entity.Entities
@inject UserManager<AppUser> UserManager
@{
    var admin = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Initials(string? f, string? l) => $"{(string.IsNullOrEmpty(f) ? "" : f[..1])}{(string.IsNullOrEmpty(l) ? "" : l[..1])}".ToUpper();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CargoTrack Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <!-- View'in en üstüne veya Layout'un <head> kısmına -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary-container": "#001e3c", "primary-container-light": "#0a2c50",
                        "on-primary-container": "#dce9ff",
                        "secondary": "#c76a00", "secondary-container": "#fd8b00", "on-secondary": "#ffffff", "on-secondary-container": "#603100",
                        "background": "#f4f6fb", "on-background": "#0b1c30",
                        "surface": "#ffffff", "surface-container": "#eef2fa", "surface-container-low": "#f7f9fd", "surface-container-high": "#e4eaf6",
                        "on-surface": "#0b1c30", "on-surface-variant": "#53586a",
                        "outline": "#8a90a3", "outline-variant": "#dfe3ee",
                        "error": "#ba1a1a", "error-container": "#ffdad6", "on-error-container": "#93000a",
                        "success": "#1b7a3d", "success-container": "#dff3e4"
                    },
                    fontFamily: { display: ["Hanken Grotesk", "sans-serif"], mono: ["IBM Plex Mono", "ui-monospace", "monospace"] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background: #f4f6fb; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24; }
        .fill-icon { font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }

        .sb-glow { position: absolute; border-radius: 9999px; filter: blur(60px); pointer-events: none; }
        .sb-item.active { position: relative; }
        .sb-item.active::before { content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 4px; height: 22px; border-radius: 0 4px 4px 0; background: #fd8b00; }
        .sb-soon { opacity: .38; transition: opacity .15s; }
        .sb-soon:hover { opacity: .6; }

        .avatar { width: 30px; height: 30px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px; flex-shrink: 0; }
        ::selection { background: #fd8b00; color: #fff; }
        .focus-ring:focus-visible { outline: 2px solid #fd8b00; outline-offset: 2px; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="flex min-h-screen">

    <!-- ============ SIDEBAR ============ -->
    <aside class="relative w-72 shrink-0 bg-primary-container text-on-primary-container flex flex-col overflow-hidden">
        <div class="sb-glow w-72 h-72 bg-secondary-container/25 -top-20 -left-24"></div>
        <div class="sb-glow w-64 h-64 bg-white/5 bottom-0 -right-20"></div>

        <div class="relative z-10 flex items-center gap-3 px-6 py-6">
            <div class="w-10 h-10 rounded-xl bg-secondary-container flex items-center justify-center shadow-lg shadow-secondary-container/30">
                <span class="material-symbols-outlined text-white fill-icon">package_2</span>
            </div>
            <div>
                <p class="font-display font-extrabold text-lg text-white leading-none">CargoTrack</p>
                <p class="text-[11px] font-semibold tracking-[0.12em] text-on-primary-container/50 mt-1">YÖNETİM PANELİ</p>
            </div>
        </div>

        <nav class="relative z-10 flex-1 px-5 py-4 space-y-1 overflow-y-auto">
            <p class="px-3 text-[11px] font-bold tracking-[0.14em] text-on-primary-container/35 mt-3 mb-2.5">OPERASYON</p>

            <a href="@Url.Action("Index", "Cargo")"
               class="sb-item @(controller == "Cargo" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
                      @(controller == "Cargo" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
                <span class="material-symbols-outlined @(controller == "Cargo" ? "fill-icon" : "") text-[22px]">local_shipping</span>
                <span>Kargolar</span>
            </a>

            <a href="@Url.Action("Index", "Branch")"
               class="sb-item @(controller == "Branch" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
                      @(controller == "Branch" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
                <span class="material-symbols-outlined @(controller == "Branch" ? "fill-icon" : "") text-[22px]">storefront</span>
                <span>Şubeler</span>
            </a>

            <a href="@Url.Action("Index", "TransferCenter")"
               class="sb-item @(controller == "TransferCenter" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
                      @(controller == "TransferCenter" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
                <span class="material-symbols-outlined @(controller == "TransferCenter" ? "fill-icon" : "") text-[22px]">hub</span>
                <span>Transfer Merkezleri</span>
            </a>

            <p class="px-3 text-[11px] font-bold tracking-[0.14em] text-on-primary-container/35 mt-6 mb-2.5">YÖNETİM</p>
            
            <a href="@Url.Action("Index", "Employee")"
               class="sb-item @(controller == "Employee" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
                      @(controller == "Employee" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
                <span class="material-symbols-outlined @(controller == "Employee" ? "fill-icon" : "") text-[22px]">groups</span>
                <span>Personel</span>
            </a>
            
           <a href="@Url.Action("Index", "User")"
   class="sb-item @(controller == "User" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
          @(controller == "User" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
    <span class="material-symbols-outlined @(controller == "User" ? "fill-icon" : "") text-[22px]">manage_accounts</span>
    <span>Kullanıcılar</span>
</a>
            
            <a href="@Url.Action("Index", "PricingRule")"
   class="sb-item @(controller == "PricingRule" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
          @(controller == "PricingRule" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
    <span class="material-symbols-outlined @(controller == "PricingRule" ? "fill-icon" : "") text-[22px]">payments</span>
    <span>Fiyat Kuralları</span>
</a>

            <p class="px-3 text-[11px] font-bold tracking-[0.14em] text-on-primary-container/35 mt-6 mb-2.5">RAPORLAMA</p>
            
           <a href="@Url.Action("Index", "Dashboard")"
   class="sb-item @(controller == "Dashboard" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
          @(controller == "Dashboard" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
    <span class="material-symbols-outlined @(controller == "Dashboard" ? "fill-icon" : "") text-[22px]">monitoring</span>
    <span>Performans</span>
</a>
            
            <a href="@Url.Action("Index", "AuditLog")"
               class="sb-item @(controller == "AuditLog" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
                      @(controller == "AuditLog" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
                <span class="material-symbols-outlined @(controller == "AuditLog" ? "fill-icon" : "") text-[22px]">history</span>
                <span>Audit Log</span>
            </a>
            <a href="@Url.Action("Index", "MachineLearning")"
   class="sb-item @(controller == "MachineLearning" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
          @(controller == "MachineLearning" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
    <span class="material-symbols-outlined @(controller == "MachineLearning" ? "fill-icon" : "") text-[22px]">psychology</span>
    <span>Yapay Zeka</span>
</a>
<a href="@Url.Action("Index", "RouteOptimization")"
   class="sb-item @(controller == "RouteOptimization" ? "active" : "") flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-colors
          @(controller == "RouteOptimization" ? "bg-secondary-container text-white shadow-lg shadow-secondary-container/25" : "text-on-primary-container/70 hover:bg-white/5 hover:text-white")">
    <span class="material-symbols-outlined @(controller == "RouteOptimization" ? "fill-icon" : "") text-[22px]">route</span>
    <span>Rota Planlama</span>
</a>

        </nav>

        <div class="relative z-10 p-4 border-t border-white/10">
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="focus-ring w-full flex items-center gap-3 px-4 py-3 rounded-xl text-on-primary-container/70 hover:bg-white/5 hover:text-white transition-colors font-medium">
                    <span class="material-symbols-outlined text-[22px]">logout</span>
                    Çıkış Yap
                </button>
            </form>
        </div>
    </aside>

    <!-- ============ MAIN ============ -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-outline-variant px-9 py-5 flex items-center justify-between shadow-[0_1px_0_rgba(11,28,48,.02)]">
            <div>
                <p class="text-xs font-semibold text-on-surface-variant/70 mb-0.5">Operasyon</p>
                <h1 class="text-2xl font-extrabold text-on-background tracking-tight">@ViewData["Title"]</h1>
            </div>
            @if (admin is not null)
            {
                <div class="flex items-center gap-3">
                    <div class="text-right leading-tight">
                        <p class="text-sm font-bold text-on-background">@admin.FirstName @admin.LastName</p>
                        <p class="text-xs text-on-surface-variant">Sistem Yöneticisi</p>
                    </div>
                    <div class="avatar w-11 h-11 text-sm bg-secondary-container text-white shadow-md shadow-secondary-container/30">
                        @Initials(admin.FirstName, admin.LastName)
                    </div>
                </div>
            }
        </header>

        <main class="flex-1 px-9 py-7 overflow-auto">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>