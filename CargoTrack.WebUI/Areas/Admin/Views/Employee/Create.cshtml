@model CargoTrack.WebUI.Models.CreateEmployeeViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Yeni Personel Ekle";
    Layout = "_AdminLayout";
    List<SelectListItem> branches = ViewBag.Branches;
}

<a href="@Url.Action("Index")" class="inline-flex items-center gap-1.5 text-sm text-on-surface-variant hover:text-primary-container mb-6 transition-colors">
    <span class="material-symbols-outlined text-base">arrow_back</span>
    Personel listesine dön
</a>

<div class="max-w-xl bg-white rounded-2xl border border-outline-variant p-7">
    <div class="flex items-center gap-3 mb-1">
        <div class="w-10 h-10 rounded-xl bg-primary-container/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary-container">person_add</span>
        </div>
        <h2 class="font-extrabold text-lg text-on-background">Yeni Personel Ekle</h2>
    </div>
    <p class="text-sm text-on-surface-variant mb-7 ml-[52px]">Bu form aynı zamanda personelin sisteme giriş yapacağı Şube Müdürü hesabını oluşturur.</p>

    <form asp-action="Create" method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-error text-sm font-medium"></div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-bold text-on-background mb-1.5">Ad</label>
                <input asp-for="FirstName" class="field-input" />
                <span asp-validation-for="FirstName" class="text-error text-xs"></span>
            </div>
            <div>
                <label class="block text-sm font-bold text-on-background mb-1.5">Soyad</label>
                <input asp-for="LastName" class="field-input" />
                <span asp-validation-for="LastName" class="text-error text-xs"></span>
            </div>
        </div>

        <div>
            <label class="block text-sm font-bold text-on-background mb-1.5">E-posta</label>
            <input asp-for="Email" class="field-input" />
            <span asp-validation-for="Email" class="text-error text-xs"></span>
        </div>

        <div>
            <label class="block text-sm font-bold text-on-background mb-1.5">Geçici Şifre</label>
            <input asp-for="Password" class="field-input" />
            <span asp-validation-for="Password" class="text-error text-xs"></span>
        </div>

        <div>
            <label class="block text-sm font-bold text-on-background mb-1.5">Pozisyon</label>
            <input asp-for="Position" placeholder="Örn: Şube Müdürü" class="field-input" />
            <span asp-validation-for="Position" class="text-error text-xs"></span>
        </div>

        <div>
            <label class="block text-sm font-bold text-on-background mb-1.5">Şube</label>
            <select asp-for="BranchId" asp-items="branches" class="field-input">
                <option value="">Seçiniz</option>
            </select>
            <span asp-validation-for="BranchId" class="text-error text-xs"></span>
        </div>

        <div class="flex gap-3 pt-3">
            <button type="submit" class="flex items-center gap-2 bg-primary-container text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-primary-container-light transition-colors">
                <span class="material-symbols-outlined text-lg">save</span>
                Personeli Oluştur
            </button>
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-xl font-bold text-sm text-on-surface-variant hover:bg-surface-container-low transition-colors">
                Vazgeç
            </a>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .field-input {
            width: 100%; border: 1.5px solid #dfe3ee; border-radius: 0.75rem;
            padding: 0.7rem 1rem; font-size: 0.9375rem; transition: border-color .15s, box-shadow .15s;
        }
        .field-input:focus { outline: none; border-color: #001e3c; box-shadow: 0 0 0 3px rgba(0,30,60,.08); }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}