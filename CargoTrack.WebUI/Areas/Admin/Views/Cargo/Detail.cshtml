@model CargoTrack.Dto.Dtos.CargoDtos.ResultCargoDto
@using CargoTrack.WebUI.Extensions
@using CargoTrack.Entity.Entities.Enums
@{
    ViewData["Title"] = "Kargo Detayı";
    Layout = "_AdminLayout";

    var status = Model.CargoStatus;
    var group = status.ToFilterGroup();
    var progress = status.ToProgressPercent();

    string SolidClass(string g) => g switch
    {
        "delivered" => "bg-success text-white",
        "problem" => "bg-error text-white",
        _ => "bg-secondary-container text-white"
    };
    string BarClass(string g) => g switch
    {
        "delivered" => "bg-success",
        "problem" => "bg-error",
        _ => "bg-gradient-to-r from-primary-container to-secondary-container"
    };
}

<a href="@Url.Action("Index")" class="pop inline-flex items-center gap-1.5 text-sm font-semibold text-on-surface-variant hover:text-primary-container mb-6 transition-colors">
    <span class="material-symbols-outlined text-base">arrow_back</span>
    Kargo listesine dön
</a>

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">

        <!-- Header card -->
        <div class="pop bg-white rounded-2xl border border-outline-variant p-7" style="animation-delay:.03s">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-7">
                <div>
                    <p class="text-xs font-bold tracking-[0.08em] text-on-surface-variant/60 uppercase mb-1">Takip Numarası</p>
                    <p class="font-mono text-3xl font-extrabold text-on-background">@Model.TrackCode</p>
                </div>
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold @status.ToAdminBadgeClass()">
                    @if (status.HasActivePulse())
                    {
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full @status.ToDotColor() opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 @status.ToDotColor()"></span>
                        </span>
                    }
                    <span class="material-symbols-outlined text-lg">@status.ToIcon()</span>
                    @status.ToDisplayText()
                </span>
            </div>

            <!-- Route strip -->
            <div class="bg-surface-container-low rounded-xl p-6 mb-7">
                <div class="grid grid-cols-[auto_1fr_auto] items-center gap-6">
                    <div>
                        <div class="w-10 h-10 rounded-lg bg-primary-container/10 flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-primary-container">inventory_2</span>
                        </div>
                        <p class="font-bold text-on-background">@Model.OriginCityName</p>
                        <p class="text-xs text-on-surface-variant">@Model.OriginBranchName</p>
                    </div>
                    <div class="relative h-2">
                        <div class="absolute inset-0 bg-outline-variant rounded-full"></div>
                        <div class="absolute inset-y-0 left-0 rounded-full @BarClass(group)" style="width:@(progress)%"></div>
                        <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-7 h-7 rounded-full flex items-center justify-center shadow-md @SolidClass(group)" style="left:@(progress)%">
                            <span class="material-symbols-outlined" style="font-size:16px">@status.ToIcon()</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="w-10 h-10 rounded-lg bg-secondary-container/10 flex items-center justify-center mb-2 ml-auto">
                            <span class="material-symbols-outlined text-secondary">home_pin</span>
                        </div>
                        <p class="font-bold text-on-background">@Model.DestinationCityName</p>
                        <p class="text-xs text-on-surface-variant">@Model.DestinationBranchName</p>
                    </div>
                </div>
            </div>

            <!-- People -->
            <div class="grid sm:grid-cols-2 gap-4 mb-7">
                <div class="bg-surface-container-low rounded-xl p-4 flex items-center gap-3">
                    <span class="avatar w-11 h-11 text-sm bg-primary-container text-white">@Model.SenderFullName.ToInitials()</span>
                    <div class="min-w-0">
                        <p class="text-xs text-on-surface-variant/70 flex items-center gap-1"><span class="material-symbols-outlined text-sm">north_east</span>Gönderici</p>
                        <p class="font-bold text-on-background truncate">@Model.SenderFullName</p>
                        <p class="text-xs text-on-surface-variant truncate">@Model.OriginBranchName</p>
                    </div>
                </div>
                <div class="bg-surface-container-low rounded-xl p-4 flex items-center gap-3">
                    <span class="avatar w-11 h-11 text-sm bg-secondary-container text-white">@Model.ReceiverFullName.ToInitials()</span>
                    <div class="min-w-0">
                        <p class="text-xs text-on-surface-variant/70 flex items-center gap-1"><span class="material-symbols-outlined text-sm">south_west</span>Alıcı</p>
                        <p class="font-bold text-on-background truncate">@Model.ReceiverFullName</p>
                        <p class="text-xs text-on-surface-variant truncate">@Model.DestinationBranchName</p>
                    </div>
                </div>
            </div>

            <!-- Package -->
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                <div class="bg-surface-container-low rounded-xl p-3.5 text-center">
                    <p class="text-[10px] font-bold tracking-wide text-on-surface-variant/60 uppercase mb-1">Tip</p>
                    <p class="font-bold text-sm text-on-background">@Model.CargoType.ToDisplayText()</p>
                </div>
                <div class="bg-surface-container-low rounded-xl p-3.5 text-center">
                    <p class="text-[10px] font-bold tracking-wide text-on-surface-variant/60 uppercase mb-1">Ağırlık</p>
                    <p class="font-bold text-sm text-on-background">@Model.Weight.ToTrNumber() kg</p>
                </div>
                <div class="bg-surface-container-low rounded-xl p-3.5 text-center">
                    <p class="text-[10px] font-bold tracking-wide text-on-surface-variant/60 uppercase mb-1">Desi</p>
                    <p class="font-bold text-sm text-on-background">@Model.Desi.ToTrNumber()</p>
                </div>
                <div class="bg-surface-container-low rounded-xl p-3.5 text-center">
                    <p class="text-[10px] font-bold tracking-wide text-on-surface-variant/60 uppercase mb-1">Gönderim</p>
                    <p class="font-bold text-sm text-on-background">@Model.ShipmentDate.ToShortTr()</p>
                </div>
                <div class="bg-surface-container-low rounded-xl p-3.5 text-center">
                    <p class="text-[10px] font-bold tracking-wide text-on-surface-variant/60 uppercase mb-1">Tah. Teslimat</p>
                    <p class="font-bold text-sm @(Model.IsDelayed ? "text-error" : "text-on-background")">@Model.EstimatedArrivalDate.ToShortTr()</p>
                </div>
            </div>
        </div>

        <!-- Movements -->
        <div class="pop bg-white rounded-2xl border border-outline-variant p-7" style="animation-delay:.08s">
            <h2 class="font-extrabold text-lg text-on-background mb-6">Kargo Hareketleri</h2>
            <div>
                @for (int i = 0; i < Model.Movements.Count; i++)
                {
                    var m = Model.Movements[i];
                    var isLast = i == Model.Movements.Count - 1;
                    <div class="flex gap-4 pb-6 relative">
                        @if (!isLast)
                        {
                            <div class="absolute left-[13px] top-7 bottom-0 w-px bg-outline-variant"></div>
                        }
                        <div class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 z-10 @(isLast ? SolidClass(group) : "bg-primary-container text-white")">
                            <span class="material-symbols-outlined" style="font-size:15px;">@m.NewStatus.ToIcon()</span>
                        </div>
                        <div class="pt-0.5">
                            <p class="font-bold text-sm text-on-background">@m.NewStatus.ToDisplayText()</p>
                            <p class="text-sm text-on-surface-variant mt-0.5">@m.LocationName • @m.MovementDate.ToDateTimeTr()</p>
                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <p class="text-xs text-on-surface-variant/70 mt-1">@m.Description</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
        <div class="pop bg-white rounded-2xl border border-outline-variant p-6" style="animation-delay:.05s">
            <h2 class="font-extrabold text-on-background mb-4">Hızlı İşlemler</h2>
            <a href="@Url.Action("Update", new { id = Model.Id })"
               class="w-full flex items-center justify-center gap-2 bg-primary-container text-white px-4 py-3 rounded-xl font-bold text-sm hover:bg-primary-container-light transition-colors">
                <span class="material-symbols-outlined text-lg">edit</span>
                Kargo Bilgilerini Düzenle
            </a>
            <p class="text-xs text-on-surface-variant mt-3 leading-relaxed">
                Durum değişikliği ve yeni hareket girişi, ilgili şubenin operasyon ekranından yapılır.
            </p>
        </div>

        @if (Model.IsDelayed)
        {
            <div class="pop bg-error-container rounded-2xl p-5 flex items-start gap-3" style="animation-delay:.08s">
                <span class="material-symbols-outlined text-error mt-0.5">warning</span>
                <div>
                    <p class="font-bold text-sm text-on-error-container">Tahmini teslimat süresi aşıldı</p>
                    <p class="text-xs text-on-error-container/80 mt-1">Şube ile iletişime geçmeyi düşünebilirsiniz.</p>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .pop { animation: pop .4s cubic-bezier(.2,.8,.2,1) both; }
        @@keyframes pop { from { opacity: 0; transform: translateY(8px); } }
        .avatar { border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
    </style>
}