@{
    ViewData["Title"] = "Yetkisiz Erişim";
    Layout = "_PublicLayout";
}

<section class="bg-paper min-h-[60vh] flex items-center justify-center text-center px-6">
    <div>
        <span class="material-symbols-outlined text-rust" style="font-size:56px;">block</span>
        <h1 class="font-display font-bold text-2xl mt-4 mb-2">Bu sayfaya erişim yetkiniz yok</h1>
        <p class="text-ink/55 mb-6">Bu işlemi gerçekleştirmek için gerekli role sahip değilsiniz.</p>
        <a href="@Url.Action("Track", "Cargo")" class="inline-block bg-ink text-paper rounded-lg px-6 py-3 font-display font-semibold hover:bg-teal transition-colors">
