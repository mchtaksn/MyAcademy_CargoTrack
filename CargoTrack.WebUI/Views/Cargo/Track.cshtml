@{
    ViewData["Title"] = "Kargo Takip";
    Layout = "_PublicLayout";
}

<div class="relative bg-ink text-paper overflow-hidden">

    <div class="absolute w-96 h-96 rounded-full bg-amber/20 -top-20 -left-10" style="filter:blur(70px);"></div>
    <div class="absolute w-[28rem] h-[28rem] rounded-full bg-teal/20 top-40 right-0" style="filter:blur(70px);"></div>
    <div class="absolute inset-0 opacity-40" style="background-image:radial-gradient(rgba(232,169,59,0.14) 1px, transparent 1px); background-size:26px 26px;"></div>

    <section class="relative z-10 max-w-6xl mx-auto px-6 pt-16 pb-24 grid lg:grid-cols-2 gap-14 items-center">

        <div>
            <span class="stamp hero-fade" style="animation-delay:.05s">
                <span class="material-symbols-outlined text-sm">bolt</span>
                Gerçek zamanlı takip
            </span>

            <h1 class="hero-fade font-display font-bold text-[2.6rem] sm:text-6xl leading-[1.05] tracking-tight mt-6 mb-5"
                style="animation-delay:.15s">
                Gönderiniz yolda.<br />
                <span class="text-paper/50">Biz her adımını izliyoruz.</span>
            </h1>

            <p class="hero-fade text-lg text-paper/60 mb-10 max-w-md" style="animation-delay:.25s">
                Takip numaranızı girin — gönderinizin şu anki konumunu, geçtiği her şubeyi
                ve tahmini teslimat saatini canlı olarak görün.
            </p>

            <form asp-action="Track" asp-controller="Cargo" method="post"
                  class="hero-fade flex flex-col sm:flex-row gap-3 max-w-lg" style="animation-delay:.35s">
                @Html.AntiForgeryToken()
                <input type="text" name="trackCode" placeholder="MYC-2026-849251"
                       class="flex-grow bg-inkSoft border border-paper/20 rounded-lg px-5 py-3.5 font-mono text-amber text-lg
                              placeholder:text-paper/25 focus:outline-none focus:border-amber transition-colors" />
                <button type="submit"
                        class="bg-amber text-ink rounded-lg px-8 py-3.5 font-display font-semibold
                               hover:bg-paper transition-colors flex items-center justify-center gap-2">
                    Sorgula
                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </button>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <p class="hero-fade mt-4 text-rust text-sm" style="animation-delay:.4s">
                    @Html.ValidationSummary(true, "", new { @class = "" })
                </p>
            }
        </div>

        <!-- Hero visual: tamamen SVG içinde, konteyner boyutundan bağımsız hizalama -->
        <div class="hero-fade hidden lg:block" style="animation-delay:.3s">
            <svg viewBox="0 0 640 400" class="w-full h-auto">
                <defs>
                    <linearGradient id="cometGrad" x1="0" y1="0" x2="1" y2="0.3">
                        <stop offset="0%" stop-color="#E8A93B" stop-opacity="0" />
                        <stop offset="50%" stop-color="#F4C868" stop-opacity="1" />
                        <stop offset="100%" stop-color="#E8A93B" stop-opacity="0" />
                    </linearGradient>
                    <filter id="softBlur" x="-100%" y="-100%" width="300%" height="300%">
                        <feGaussianBlur stdDeviation="6" />
                    </filter>
                </defs>

                <path class="route-path" d="M40,210 C160,40 300,340 460,120 C540,10 560,60 600,90"
                      fill="none" stroke="#E8A93B" stroke-width="1.5" stroke-linecap="round" opacity="0.3" />
                <path class="route-comet" d="M40,210 C160,40 300,340 460,120 C540,10 560,60 600,90"
                      fill="none" stroke="url(#cometGrad)" stroke-width="3.5" stroke-linecap="round" />

                <!-- Çıkış noktası -->
                <circle cx="40" cy="210" r="22" fill="#111C2B" stroke="#2A8577" stroke-width="1.5" />
                <foreignObject x="18" y="188" width="44" height="44">
                    <div xmlns="http://www.w3.org/1999/xhtml" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                        <span class="material-symbols-outlined" style="color:#2A8577; font-size:20px;">inventory_2</span>
                    </div>
                </foreignObject>
                <foreignObject x="68" y="197" width="150" height="26">
                    <div xmlns="http://www.w3.org/1999/xhtml" style="font-family:'Inter',sans-serif; font-size:14px; font-weight:500; color:rgba(243,245,241,.8); white-space:nowrap;">Kargo Şubesi</div>
                </foreignObject>

                <!-- Varış noktası -->
                <circle cx="600" cy="90" r="22" fill="#111C2B" stroke="#E8A93B" stroke-width="1.5" />
                <foreignObject x="578" y="68" width="44" height="44">
                    <div xmlns="http://www.w3.org/1999/xhtml" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                        <span class="material-symbols-outlined" style="color:#E8A93B; font-size:20px;">home_pin</span>
                    </div>
                </foreignObject>
                <foreignObject x="435" y="34" width="155" height="26">
                    <div xmlns="http://www.w3.org/1999/xhtml" style="font-family:'Inter',sans-serif; font-size:14px; font-weight:500; color:rgba(243,245,241,.8); white-space:nowrap; text-align:right;">Kapınıza Kadar</div>
                </foreignObject>

                <!-- Durum etiketi -->
                <foreignObject x="185" y="0" width="190" height="58">
                    <div xmlns="http://www.w3.org/1999/xhtml" style="background:#111C2B; border:1px solid rgba(243,245,241,.15); border-radius:12px; padding:9px 14px; box-shadow:0 10px 25px rgba(0,0,0,.35);">
                        <p style="font-family:'Inter',sans-serif; font-size:10px; letter-spacing:.05em; color:rgba(243,245,241,.4); margin:0 0 4px;">DURUM</p>
                        <p style="font-family:'Inter',sans-serif; font-size:13px; font-weight:500; color:#2A8577; margin:0; display:flex; align-items:center; gap:4px;">
                            <span class="material-symbols-outlined" style="font-size:14px;">swap_horiz</span> Transfer Merkezinde
                        </p>
                    </div>
                </foreignObject>

                <!-- Kamyonun ışık izi -->
                <circle r="22" fill="#E8A93B" opacity="0.4" filter="url(#softBlur)">
                    <animateMotion dur="5.5s" begin="2.85s" repeatCount="indefinite"
                                   path="M40,210 C160,40 300,340 460,120 C540,10 560,60 600,90" />
                </circle>

                <!-- Kamyon -->
                <g>
                    <animateMotion dur="5.5s" begin="2.6s" repeatCount="indefinite"
                                   path="M40,210 C160,40 300,340 460,120 C540,10 560,60 600,90" />
                    <circle r="20" fill="#E8A93B" />
                    <foreignObject x="-14" y="-14" width="28" height="28">
                        <div xmlns="http://www.w3.org/1999/xhtml" class="truck-bounce" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                            <span class="material-symbols-outlined" style="color:#0B141F; font-size:18px;">local_shipping</span>
                        </div>
                    </foreignObject>
                </g>
            </svg>
        </div>
    </section>

    <div class="hazard"></div>
</div>

<div class="bg-inkSoft border-b border-paper/5">
    <div class="max-w-6xl mx-auto px-6 py-6 grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-amber">notifications_active</span>
            <span class="text-sm text-paper/70">Anlık durum bildirimi</span>
        </div>
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-amber">schedule</span>
            <span class="text-sm text-paper/70">7/24 canlı takip</span>
        </div>
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-amber">verified_user</span>
            <span class="text-sm text-paper/70">Kod doğrulamalı teslimat</span>
        </div>
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-amber">location_on</span>
            <span class="text-sm text-paper/70">Şube bazlı hareket geçmişi</span>
        </div>
    </div>
</div>

<section class="bg-paper">
    <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-3 divide-x divide-ink/10 text-center">
        <div>
            <p class="font-display font-bold text-4xl">120+</p>
            <p class="text-sm text-ink/50 mt-1">Şube</p>
        </div>
        <div>
            <p class="font-display font-bold text-4xl text-teal">%97</p>
            <p class="text-sm text-ink/50 mt-1">Zamanında Teslimat</p>
        </div>
        <div>
            <p class="font-display font-bold text-4xl">1.8 gün</p>
            <p class="text-sm text-ink/50 mt-1">Ortalama Teslimat Süresi</p>
        </div>
    </div>
</section>

<section class="bg-paper border-t border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-24">
        <div class="max-w-lg mb-14">
            <span class="text-sm font-medium text-teal">Süreç</span>
            <h2 class="font-display font-semibold text-3xl mt-2">Takip numaranız nasıl çalışır?</h2>
            <p class="text-ink/55 mt-3 leading-relaxed">
                Kargonuz bize ulaştığı andan kapınıza gelene kadar üç aşamadan geçer, her aşama sistemde anında kayıt altına alınır.
            </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
            <div class="relative bg-white rounded-2xl border border-ink/10 p-7 overflow-hidden">
                <span class="absolute -right-2 -top-6 font-display font-bold text-8xl text-ink/[0.04] select-none">01</span>
                <div class="relative w-12 h-12 rounded-xl bg-ink flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-paper">inventory_2</span>
                </div>
                <p class="relative font-display font-semibold text-lg mb-2">Şubede kabul</p>
                <p class="relative text-sm text-ink/55 leading-relaxed">
                    Kargonuz teslim alındığında benzersiz bir takip numarası üretilir ve size iletilir.
                </p>
            </div>

            <div class="relative bg-white rounded-2xl border border-ink/10 p-7 overflow-hidden">
                <span class="absolute -right-2 -top-6 font-display font-bold text-8xl text-amber/10 select-none">02</span>
                <div class="relative w-12 h-12 rounded-xl bg-amber flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-ink">swap_horiz</span>
                </div>
                <p class="relative font-display font-semibold text-lg mb-2">Transfer ve dağıtım</p>
                <p class="relative text-sm text-ink/55 leading-relaxed">
                    Şubeler ve transfer merkezleri arasındaki her hareket anlık olarak sisteme işlenir.
                </p>
            </div>

            <div class="relative bg-white rounded-2xl border border-ink/10 p-7 overflow-hidden">
                <span class="absolute -right-2 -top-6 font-display font-bold text-8xl text-teal/10 select-none">03</span>
                <div class="relative w-12 h-12 rounded-xl bg-teal flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-paper">task_alt</span>
                </div>
                <p class="relative font-display font-semibold text-lg mb-2">Teslimat</p>
                <p class="relative text-sm text-ink/55 leading-relaxed">
                    Teslim alan kişi ve saat, doğrulama koduyla birlikte kayıt altına alınır.
                </p>
            </div>
        </div>
    </div>
</section>

@section Styles {
<style>
    .route-path {
        stroke-dasharray: 900;
        stroke-dashoffset: 900;
        animation: draw 2.4s ease forwards 0.4s;
    }
    @@keyframes draw { to { stroke-dashoffset: 0; } }

    .route-comet {
        stroke-dasharray: 130 900;
        animation: comet 5.5s linear infinite;
        animation-delay: 2.8s;
        opacity: 0;
    }
    @@keyframes comet {
        0%   { stroke-dashoffset: 900; opacity: 0; }
        4%   { opacity: 1; }
        94%  { opacity: 1; }
        100% { stroke-dashoffset: -160; opacity: 0; }
    }

    .truck-bounce {
        animation: bounce 0.55s ease-in-out infinite alternate;
    }
    @@keyframes bounce {
        from { transform: translateY(0) rotate(-2deg); }
        to   { transform: translateY(-2px) rotate(2deg); }
    }
</style>
}